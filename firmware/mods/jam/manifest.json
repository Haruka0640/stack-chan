    "./domain/default-song": "./domain/default-song",
    "./domain/loop-player": "./domain/loop-player",
    "./domain/session-controller": "./domain/session-controller",
    "./domain/song-loader": "./domain/song-loader",
    "./domain/timing": "./domain/timing",
    "./domain/types": "./domain/types",
    "./support/log": "./support/log",
    "./ui/session-display": "./ui/session-display"
  },
  "resources": {
    "*": "./session/loop4.maud"
  }
}
